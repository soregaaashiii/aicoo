<section id="lovable-pipeline-live"
         class="dashboard-section lovable-pipeline-overview"
         aria-live="polite"
         data-lovable-pipeline-live
         data-refresh-enabled="<%= overview.refresh? %>"
         data-refresh-url="<%= pipeline_status_business_lovable_landing_page_path(business, landing_page_id: landing_page&.id) %>">
  <div class="section-heading">
    <div>
      <h2>Pipeline Explorer</h2>
      <p>工程を開くと、AIの実行内容、停止原因、必要設定、直し方を確認できます。</p>
    </div>
  </div>

  <div class="lovable-pipeline-diagnosis status-<%= diagnosis.level %>" data-pipeline-diagnosis>
    <div>
      <span>診断結果</span>
      <strong><%= diagnosis.status_label %></strong>
    </div>
    <ul aria-label="Pipeline診断結果">
      <% diagnosis.components.each do |component| %>
        <li class="status-<%= component.level %>">
          <span><%= component.label %></span>
          <strong><%= component.status_label %></strong>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="lovable-current-location status-<%= overview.failed? ? "failed" : (overview.completed? ? "completed" : "active") %>">
    <div class="lovable-current-position">
      <span>現在</span>
      <strong><%= overview.current_position %> / <%= Aicoo::Lovable::PipelineOverview::STAGE_DEFINITIONS.size %></strong>
      <small><%= overview.headline_status %></small>
    </div>
    <dl>
      <div>
        <dt>現在地</dt>
        <dd><%= overview.current_label %></dd>
      </div>
      <div>
        <dt>次</dt>
        <dd><%= overview.next_label %></dd>
      </div>
      <div>
        <dt>あなたの操作</dt>
        <dd><%= overview.user_operation %></dd>
      </div>
    </dl>
  </div>

  <div class="lovable-pipeline-layout">
    <ol class="lovable-pipeline-timeline" aria-label="LP Pipeline">
      <% overview.stages.each do |stage| %>
        <% component_key = Aicoo::Lovable::PipelineDiagnosis.component_for_stage(stage.key) %>
        <% component = diagnosis.component(component_key) if component_key %>
        <li class="lovable-pipeline-step status-<%= stage.status %>" data-pipeline-stage="<%= stage.key %>">
          <span class="lovable-pipeline-marker" aria-hidden="true">
            <%= stage.status == "completed" ? "✓" : stage.number %>
          </span>
          <details class="lovable-pipeline-explorer-stage"
                   data-pipeline-explorer-stage="<%= stage.key %>"
                   <%= "open" if stage.status.in?(%w[current failed recovering]) %>>
            <summary>
              <span>
                <strong><%= stage.label %></strong>
                <small>
                  <%= overview.stage_status_label(stage) %>
                  <% if stage.timestamp %>
                    / <time datetime="<%= stage.timestamp.iso8601 %>"><%= l(stage.timestamp, format: :short) %></time>
                  <% end %>
                </small>
                <% if stage.detail.present? %>
                  <span class="lovable-pipeline-detail"><%= stage.detail %></span>
                <% end %>
              </span>
            </summary>

            <% if component %>
              <div class="lovable-pipeline-self-diagnosis status-<%= component.level %>">
                <dl class="lovable-pipeline-diagnosis-summary">
                  <div><dt>接続状態</dt><dd><strong><%= component.connection_status %></strong></dd></div>
                  <div><dt>原因</dt><dd><%= component.cause %></dd></div>
                  <% if component.required_setting.present? %>
                    <div><dt>必要設定</dt><dd><%= component.required_setting %></dd></div>
                  <% end %>
                </dl>

                <% settings_link = pipeline_diagnosis_settings_link(component, landing_page:) %>
                <% if settings_link || (component.recheckable && generation_run) %>
                  <div class="lovable-pipeline-diagnosis-actions">
                    <% if settings_link %>
                      <%= link_to settings_link.fetch(:label),
                                  settings_link.fetch(:url),
                                  class: "button",
                                  target: "_blank",
                                  rel: "noopener",
                                  data: { pipeline_setting_link: component.key } %>
                    <% end %>
                    <% if component.recheckable && generation_run %>
                      <%= button_to "再確認",
                                    recheck_pipeline_business_lovable_landing_page_path(
                                      business,
                                      landing_page_id: landing_page&.id
                                    ),
                                    method: :post,
                                    params: { component: component.key },
                                    class: "button secondary" %>
                    <% end %>
                  </div>
                <% end %>

                <% if component.details.any? || component.settings_location.present? || component.fix_steps.any? %>
                  <details class="lovable-pipeline-diagnosis-details">
                    <summary>詳細を見る</summary>
                    <dl>
                      <% component.details.each do |label, value| %>
                        <div>
                          <dt><%= label %></dt>
                          <dd>
                            <% if value.blank? %>
                              <span class="muted">未記録</span>
                            <% elsif value.is_a?(Array) %>
                              <%= value.join(", ") %>
                            <% else %>
                              <%= value %>
                            <% end %>
                          </dd>
                        </div>
                      <% end %>
                      <% if component.settings_location.present? %>
                        <div><dt>設定場所</dt><dd><%= component.settings_location %></dd></div>
                      <% end %>
                      <% if component.fix_steps.any? %>
                        <div>
                          <dt>直し方</dt>
                          <dd><ol><% component.fix_steps.each do |step| %><li><%= step %></li><% end %></ol></dd>
                        </div>
                      <% end %>
                    </dl>
                  </details>
                <% end %>
              </div>
            <% end %>

            <details class="lovable-pipeline-developer-details">
              <summary>開発者向け詳細</summary>
              <dl class="lovable-pipeline-diagnostics">
                <% stage.diagnostics.each do |diagnostic| %>
                  <div>
                    <dt><%= diagnostic.label %></dt>
                    <dd>
                      <% if diagnostic.value.blank? %>
                        <span class="muted">未記録</span>
                      <% elsif diagnostic.value.is_a?(Array) %>
                        <ul>
                          <% diagnostic.value.each do |value| %><li><%= value %></li><% end %>
                        </ul>
                      <% elsif diagnostic.value.is_a?(Hash) %>
                        <%= diagnostic.value.to_json %>
                      <% elsif diagnostic.value.is_a?(Time) || diagnostic.value.is_a?(Date) || diagnostic.value.is_a?(ActiveSupport::TimeWithZone) %>
                        <time datetime="<%= diagnostic.value.in_time_zone.iso8601 %>"><%= l(diagnostic.value.in_time_zone, format: :short) %></time>
                      <% elsif diagnostic.url.present? %>
                        <%= link_to diagnostic.value, diagnostic.url, target: "_blank", rel: "noopener" %>
                      <% else %>
                        <%= diagnostic.value %>
                      <% end %>
                    </dd>
                  </div>
                <% end %>
              </dl>
            </details>
          </details>
        </li>
      <% end %>
    </ol>

    <div class="lovable-pipeline-guidance">
      <div class="aicoo-notice <%= "status-warning" if overview.failed? %>">
        <strong>次にやること</strong>
        <p><%= diagnosis.next_action.text %></p>

        <div class="compact-actions">
          <% if diagnosis.next_action.kind == :create && landing_page %>
            <details class="business-access-editor lovable-inline-lp-creation">
              <summary class="button">＋LP作成</summary>
              <%= render "businesses/landing_page_creation_form",
                         business:,
                         landing_page:,
                         form_url: start_creation_business_lovable_landing_page_path(business),
                         show_cancel: false %>
            </details>
          <% elsif diagnosis.next_action.kind == :approve && task %>
            <%= button_to "承認",
                          approve_business_lovable_landing_page_path(
                            business,
                            landing_page_id: landing_page&.id,
                            auto_revision_task_id: task.id
                          ),
                          method: :patch,
                          class: "button",
                          data: { turbo_confirm: "LP戦略とPromptを承認します。よろしいですか？" } %>
          <% elsif diagnosis.next_action.kind == :generate && overview.build_url.present? %>
            <%= link_to "Lovableを開いてGenerate", overview.build_url, class: "button", target: "_blank", rel: "noopener" %>
          <% elsif diagnosis.next_action.kind == :recheck && generation_run %>
            <%= button_to "再確認",
                          recheck_pipeline_business_lovable_landing_page_path(
                            business,
                            landing_page_id: landing_page&.id
                          ),
                          method: :post,
                          params: { component: diagnosis.next_action.component },
                          class: "button" %>
          <% elsif diagnosis.next_action.kind == :settings && landing_page %>
            <% if diagnosis.next_action.component.in?(%i[ga4 gsc]) %>
              <%= link_to "Google再認証", google_settings_business_path(business), class: "button" %>
            <% else %>
              <%= link_to "設定を開く",
                          business_lovable_landing_page_path(business, landing_page_id: landing_page.id, anchor: "lp-settings"),
                          class: "button" %>
            <% end %>
          <% end %>
        </div>
      </div>

      <% if overview.failed? %>
        <div class="lovable-pipeline-error">
          <strong><%= overview.error_code.presence || "pipeline_error" %></strong>
          <p><%= overview.error_message.presence || "処理を継続できませんでした。" %></p>
        </div>
      <% end %>

      <% if overview.commit_sha.present? || overview.public_url.present? %>
        <dl class="business-access-values lovable-pipeline-output">
          <% if overview.commit_sha.present? %>
            <dt>Commit SHA</dt><dd><%= overview.commit_sha %></dd>
          <% end %>
          <% if overview.public_url.present? %>
            <dt>公開URL</dt><dd><%= link_to overview.public_url, overview.public_url, target: "_blank", rel: "noopener" %></dd>
          <% end %>
        </dl>
      <% end %>

      <details class="lovable-pipeline-history">
        <summary>開発者向け: Pipeline履歴</summary>
        <% if overview.history.any? %>
          <ol>
            <% overview.history.each do |entry| %>
              <li>
                <time datetime="<%= entry.timestamp.iso8601 %>"><%= entry.timestamp.strftime("%H:%M") %></time>
                <span><%= entry.label %></span>
                <% if entry.detail.present? %><small><%= entry.detail %></small><% end %>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="muted">履歴はまだありません。</p>
        <% end %>
      </details>
    </div>
  </div>
</section>
