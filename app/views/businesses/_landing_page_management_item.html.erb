<% landing_page = lp_row.fetch(:landing_page) %>
<% metadata = landing_page.metadata.to_h %>
<% purpose_label = metadata["creation_purpose_label"].presence ||
  Aicoo::LpIntegration::LandingPageStrategyBuilder::PURPOSES[metadata["creation_purpose"].to_s] ||
  "その他" %>
<% detail_path = business_lovable_landing_page_path(business, landing_page_id: landing_page.id) %>
<% learning_status = lp_row.dig(:learning, "status").presence || "改善後データ待ち" %>

<article class="business-access-list-item business-lp-row" id="external-lp-<%= landing_page.id %>">
  <div class="business-access-item-heading">
    <div>
      <span><%= display_rank %>位</span>
      <strong><%= link_to landing_page.landing_page_name, detail_path %></strong>
      <small><%= purpose_label %></small>
    </div>
    <span class="pill"><%= landing_page.landing_page_public_status_label %></span>
  </div>

  <dl class="business-access-values lp-analysis-values">
    <dt>公開URL</dt>
    <dd><%= landing_page.landing_page_url.presence || "未公開" %></dd>
    <dt>Cloudflare</dt>
    <dd><%= landing_page.landing_page_cloudflare_url.presence || metadata["cloudflare_deploy_status"].presence || "未公開" %></dd>
    <dt>GitHub</dt>
    <dd><%= landing_page.landing_page_repository_url.presence || landing_page.landing_page_publication_repository_url.presence || cloudflare_configuration.repository_url %></dd>
    <dt>状態</dt>
    <dd><%= landing_page.landing_page_public_status_label %> / <%= landing_page.landing_page_sync_status_label %></dd>
    <dt>期待利益</dt>
    <dd><%= number_to_currency(lp_row.fetch(:expected_profit_yen), unit: "¥", precision: 0) %></dd>
    <dt>CV率 / CTR / 順位</dt>
    <dd>
      <%= lp_row[:conversion_rate] ? number_to_percentage(lp_row[:conversion_rate] * 100, precision: 2) : "未計測" %>
      /
      <%= lp_row[:ctr] ? number_to_percentage(lp_row[:ctr] * 100, precision: 2) : "未計測" %>
      /
      <%= lp_row[:average_position] || "未計測" %>
    </dd>
    <dt>改善 / Learning</dt>
    <dd><%= lp_row.fetch(:improvement_count) %>回 / <%= learning_status %></dd>
    <dt>最終更新 / 公開日</dt>
    <dd>
      <%= l(landing_page.updated_at, format: :short) %>
      /
      <%= landing_page.landing_page_last_published_at ? l(landing_page.landing_page_last_published_at, format: :short) : "未公開" %>
    </dd>
  </dl>

  <div class="business-access-card-actions">
    <%= link_to "LP詳細", detail_path, class: "button" %>
    <% if landing_page.landing_page_url.present? %>
      <%= link_to "公開URLを開く", landing_page.landing_page_url, class: "button secondary", target: "_blank", rel: "noopener" %>
    <% end %>
  </div>
</article>
