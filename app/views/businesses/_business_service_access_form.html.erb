<% metadata = service&.metadata.to_h || {} %>
<% form_namespace = "service_#{service&.id || 'new'}" %>
<%= form_with url: service_business_access_settings_path(business), method: :patch, scope: :service_access, namespace: form_namespace, class: "business-access-form service-settings-form" do |form| %>
  <%= form.hidden_field :business_service_id, value: service&.id %>
  <div class="field">
    <%= form.label :name, "Service名" %>
    <%= form.text_field :name, value: service&.name, placeholder: "AI受付 API" %>
  </div>
  <div class="field">
    <%= form.label :github_repository, "GitHub Repository" %>
    <%= form.url_field :github_repository, value: service&.repository, placeholder: "https://github.com/owner/service" %>
  </div>
  <div class="field">
    <%= form.label :branch, "Branch" %>
    <%= form.text_field :branch, value: metadata["branch"].presence || "main" %>
  </div>
  <div class="field">
    <%= form.label :framework, "Framework" %>
    <%= form.select :framework,
                    options_for_select(BusinessExecutionProfile::REPOSITORY_TYPES.map { |type| [type, type] }, metadata["framework"]) %>
  </div>
  <div class="field">
    <%= form.label :render_service_name, "Render Service" %>
    <%= form.text_field :render_service_name, value: service&.render_service, placeholder: "service-web" %>
  </div>
  <div class="field">
    <%= form.label :deploy_target, "デプロイ先" %>
    <%= form.text_field :deploy_target, value: service&.deploy_target.presence || "render", placeholder: "render" %>
  </div>
  <div class="field">
    <%= form.label :domain, "ドメイン" %>
    <%= form.text_field :domain, value: service&.domain, placeholder: "service.example.com" %>
  </div>
  <div class="field">
    <%= form.label :stripe_account, "Stripe Account" %>
    <%= form.text_field :stripe_account, value: service&.stripe_account, placeholder: "acct_..." %>
  </div>
  <div class="field">
    <%= form.label :status, "ステータス" %>
    <%= form.select :status,
                    options_for_select(BusinessService::STATUSES.map { |status| [business_service_status_label(status), status] }, service&.status || "planning") %>
  </div>
  <fieldset class="service-page-settings">
    <legend>ユーザーページ</legend>
    <% if service %>
      <p class="aicoo-help-text">Service登録時のURLです。ここで追加登録する必要はありません。</p>
      <div class="service-page-setting-row">
        <div class="service-page-readonly-value">
          <% if service.url.present? %>
            <%= link_to service.url, service.url, target: "_blank", rel: "noopener", class: "business-service-url-link" %>
          <% else %>
            <span class="aicoo-empty-state">Service URLは未登録です。</span>
          <% end %>
        </div>
        <div class="service-page-setting-options">
          <label class="checkbox-field">
            <%= form.check_box :user_page_analysis_enabled,
                               { checked: service.page_analysis_enabled?("user"), disabled: service.url.blank? },
                               "1",
                               "0" %>
            分析対象にする
          </label>
        </div>
      </div>
    <% else %>
      <p class="aicoo-help-text">Serviceを最初に登録するURLが、そのままユーザーページになります。</p>
      <div class="service-page-setting-row">
        <div class="field service-page-url-field">
          <%= form.label :service_url, "ユーザーページURL" %>
          <%= form.url_field :service_url, placeholder: "https://service.example.com" %>
        </div>
        <div class="service-page-setting-options">
          <label class="checkbox-field">
            <%= form.check_box :user_page_analysis_enabled, { checked: true }, "1", "0" %>
            分析対象にする
          </label>
        </div>
      </div>
    <% end %>
  </fieldset>
  <div class="field">
    <%= form.label :health_check_url, "Health Check URL" %>
    <%= form.url_field :health_check_url, value: metadata["health_check_url"], placeholder: "https://service.example.com/up" %>
  </div>
  <div class="field">
    <%= form.label :activity_api_endpoint, "Activity API" %>
    <%= form.url_field :activity_api_endpoint, value: service&.api_endpoint, placeholder: "https://service.example.com/activity" %>
  </div>
  <div class="field checkbox-field">
    <%= form.check_box :auto_deploy_enabled, { checked: ActiveModel::Type::Boolean.new.cast(metadata["auto_deploy_enabled"]) }, "1", "0" %>
    <%= form.label :auto_deploy_enabled, "自動デプロイを有効にする" %>
  </div>
  <div class="actions compact-actions">
    <%= form.submit service ? "Service設定を保存" : "Serviceを追加", class: "button" %>
    <%= link_to "Business詳細で確認", business_path(business, anchor: "business-service-access-card"), class: "button secondary" %>
  </div>
<% end %>

<% if service %>
  <section class="service-additional-pages" aria-labelledby="service-<%= service.id %>-additional-pages">
    <div class="section-heading compact">
      <div>
        <h4 id="service-<%= service.id %>-additional-pages">その他のページ</h4>
        <p>必要なページだけ、分かる名前を付けて追加できます。</p>
      </div>
    </div>

    <% service.additional_page_configurations.each do |page| %>
      <div class="service-additional-page-row">
        <%= form_with url: update_service_page_business_access_settings_path(
                            business,
                            business_service_id: service.id,
                            page_id: page[:id]
                          ),
                      method: :patch,
                      scope: :service_page,
                      class: "business-access-form service-additional-page-form" do |page_form| %>
          <div class="field">
            <%= page_form.label :name, "ページ名" %>
            <%= page_form.text_field :name, value: page[:name], placeholder: "管理画面、ヘルプ、採用情報など" %>
          </div>
          <div class="field service-page-url-field">
            <%= page_form.label :url, "URL" %>
            <%= page_form.url_field :url, value: page[:url], placeholder: "https://service.example.com/page" %>
            <%= link_to page[:url], page[:url], target: "_blank", rel: "noopener", class: "business-service-url-link" %>
          </div>
          <label class="checkbox-field">
            <%= page_form.check_box :analysis_enabled, { checked: page[:analysis_enabled] }, "1", "0" %>
            分析対象にする
          </label>
          <%= page_form.submit "保存", class: "button secondary" %>
        <% end %>
        <%= button_to "削除",
                      remove_service_page_business_access_settings_path(
                        business,
                        business_service_id: service.id,
                        page_id: page[:id]
                      ),
                      method: :delete,
                      class: "button secondary",
                      form: { data: { turbo_confirm: "#{page[:name]}を削除します。Service自体は削除されません。よろしいですか？" } } %>
      </div>
    <% end %>

    <details class="service-additional-page-add">
      <summary><strong>+ その他のページを追加</strong></summary>
      <%= form_with url: add_service_page_business_access_settings_path(
                          business,
                          business_service_id: service.id
                        ),
                    method: :post,
                    scope: :service_page,
                    class: "business-access-form service-additional-page-form" do |page_form| %>
        <div class="field">
          <%= page_form.label :name, "ページ名" %>
          <%= page_form.text_field :name, placeholder: "管理画面、ヘルプ、採用情報など", required: true %>
        </div>
        <div class="field">
          <%= page_form.label :url, "URL" %>
          <%= page_form.url_field :url, placeholder: "https://service.example.com/page", required: true %>
        </div>
        <label class="checkbox-field">
          <%= page_form.check_box :analysis_enabled, {}, "1", "0" %>
          分析対象にする
        </label>
        <%= page_form.submit "追加", class: "button" %>
      <% end %>
    </details>
  </section>
<% end %>
