<% settings_navigation_items = [
  { label: "全体設定", path: aicoo_setting_path, active_paths: [ "/aicoo_setting", "/admin/aicoo_daily_run_settings", "/admin/aicoo_auto_revision_settings" ] },
  { label: "Cloudflare", path: admin_cloudflare_connection_path, active_paths: [ "/admin/cloudflare_connection" ] },
  { label: "GA4 / GSC", path: admin_analytics_connections_path, active_paths: [ "/admin/analytics_connections" ] },
  { label: "サイト別GA4/GSC", path: admin_analytics_sites_path, active_paths: [ "/admin/analytics_sites" ] },
  { label: "Google連携", path: admin_google_credentials_path, active_paths: [ "/admin/google_credentials", "/admin/google_api_imports", "/admin/analytics_sources", "/admin/analytics_imports" ] },
  { label: "GitHub / Webhook / Lovable", path: admin_lovable_path, active_paths: [ "/admin/lovable" ] },
  { label: "Learning", path: admin_aicoo_lab_lp_learning_path, active_paths: [ "/admin/aicoo_lab/lp_learning" ] }
] %>

<nav class="aicoo-sub-tabs aicoo-settings-navigation" aria-label="全体設定内ナビゲーション">
  <% settings_navigation_items.each do |item| %>
    <% active = item[:active_paths].any? { |path| request.path.start_with?(path) } %>
    <%= link_to item[:label], item[:path], class: [ "aicoo-sub-tab", ("active" if active) ], aria: (active ? { current: "page" } : nil) %>
  <% end %>
</nav>
