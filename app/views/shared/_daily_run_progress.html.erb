<% progress = local_assigns.fetch(:progress) %>
<% compact = local_assigns.fetch(:compact, false) %>
<% refresh_key = local_assigns[:refresh_key] || "daily-run-#{progress.run.id}" %>
<% status_bar = local_assigns.fetch(:status_bar, false) %>
<% show_step_list = local_assigns.fetch(:show_step_list, !compact) %>
<% auto_refresh = local_assigns.fetch(:auto_refresh, false) %>

<div
  class="aicoo-card daily-run-progress daily-run-progress-<%= progress.state %> <%= 'daily-run-progress-compact' if compact %> <%= 'daily-run-progress-status-bar' if status_bar %>"
  data-daily-run-progress="<%= progress.run.id %>"
  data-daily-run-progress-key="<%= refresh_key %>"
  data-daily-run-state="<%= progress.state %>"
  data-progress-percent="<%= progress.progress_percent %>"
  <%= 'data-aicoo-auto-refresh="5000"'.html_safe if auto_refresh %>>
  <div class="section-heading">
    <div>
      <p><span class="pill"><%= progress.active? ? "現在実行中" : progress.status_label %></span></p>
      <h2><%= progress.active? ? "Daily Runはまだ完了していません" : progress.status_label %></h2>
    </div>
    <strong class="daily-run-progress-percent"><%= progress.progress_percent %>%</strong>
  </div>

  <div
    class="daily-run-progress-track"
    role="progressbar"
    aria-label="Daily Run進捗"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="<%= progress.progress_percent %>">
    <span style="width: <%= progress.progress_percent %>%"></span>
  </div>

  <% unless status_bar && (progress.successful? || progress.partial_failed?) %>
    <div class="metric-grid daily-run-progress-metrics">
      <div class="metric-card">
        <span>現在Step</span>
        <strong><%= progress.current_step_label %></strong>
        <% if progress.current_step_name.present? %>
          <small><%= progress.current_step_name %></small>
        <% end %>
        <% if progress.active? %>
          <small>Step内進捗 <%= progress.current_step_percent %>%</small>
        <% end %>
      </div>
      <div class="metric-card">
        <span><%= progress.active? ? "残り時間" : "所要時間" %></span>
        <strong><%= progress.active? ? progress.remaining_label : progress.elapsed_label %></strong>
        <% if progress.estimated_finish_at %>
          <small><%= status_bar ? "終了予定" : "ETA" %> <%= progress.estimated_finish_at.strftime("%H:%M") %></small>
        <% end %>
      </div>
      <div class="metric-card">
        <span>Business</span>
        <% if status_bar && progress.total_business_count.to_i.positive? %>
          <strong><%= progress.current_business_index.to_i %> / <%= progress.total_business_count.to_i %></strong>
        <% else %>
          <strong><%= progress.business_label %></strong>
        <% end %>
      </div>
      <% if progress.current_step_name == "action_generation" || progress.completed? %>
        <div class="metric-card">
          <span>ActionCandidate</span>
          <strong><%= progress.active? ? progress.candidate_label : "#{progress.candidate_count}件" %></strong>
        </div>
      <% end %>
      <% if status_bar && progress.current_business_name.present? %>
        <div class="metric-card">
          <span>現在処理中</span>
          <strong><%= progress.current_business_name %></strong>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if show_step_list %>
    <%= render "shared/daily_run_step_list", progress: %>
  <% end %>

  <% if progress.partial_failed? %>
    <div class="alert-banner daily-run-partial-failure-summary">
      <strong>実行終了・一部失敗</strong>
      <p>
        Step: <%= progress.failed_step.presence || "-" %> /
        原因: <%= progress.failure_reason.presence || "一部Stepが失敗しました" %> /
        Retry: <%= progress.retry_count %>
      </p>
    </div>
    <% unless compact %>
      <div class="daily-run-completion-summary daily-run-completion-summary-partial">
        <span>所要時間 <%= progress.elapsed_label %></span>
        <span>Business <%= progress.business_count %>件</span>
        <span>ActionCandidate <%= progress.candidate_count %>件</span>
        <span>改修Queue <%= progress.revision_queue_count %>件</span>
      </div>
    <% end %>
  <% elsif progress.failed? %>
    <div class="alert-banner alert-banner-danger">
      <strong>実行終了・失敗</strong>
      <p>
        Step: <%= progress.failed_step.presence || "-" %> /
        原因: <%= progress.failure_reason.presence || "不明" %> /
        Retry: <%= progress.retry_count %>
      </p>
    </div>
  <% elsif progress.stuck? %>
    <div class="alert-banner alert-banner-danger">
      <strong>停止中</strong>
      <p>
        Step: <%= progress.current_step_name.presence || progress.failed_step.presence || "-" %> /
        原因: <%= progress.failure_reason.presence || "処理が停止しています" %> /
        Retry: <%= progress.retry_count %>
      </p>
    </div>
  <% elsif progress.successful? && !compact %>
    <div class="daily-run-completion-summary">
      <strong>完了</strong>
      <span>所要時間 <%= progress.elapsed_label %></span>
      <span>Business <%= progress.business_count %>件</span>
      <span>ActionCandidate <%= progress.candidate_count %>件</span>
      <span>改修Queue <%= progress.revision_queue_count %>件</span>
    </div>
  <% end %>

  <% if progress.active? && !compact %>
    <p class="muted">このRunが完了するまで、同じ対象日の再実行はスキップされます。</p>
  <% end %>
</div>
